[Unit]
Description=Nightly trigger for the IsaFlow shared merchant-pattern pool recompute

[Timer]
# Every night at 03:15 SAST (after the 02:30 fraud scan). Randomised delay reduces stampede risk
# on shared DB instances.
OnCalendar=*-*-* 03:15:00 Africa/Johannesburg
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
