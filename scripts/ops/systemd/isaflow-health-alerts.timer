[Unit]
Description=Trigger isaflow-health-alerts.service every 5 minutes (admin audit OP-1)

[Timer]
# Every 5 minutes, so a degraded/critical system alerts without an admin having
# /admin/health open. checkAndAlert debounces (status change, else once an hour),
# so the frequency adds checks, not mail. No catch-up after downtime: a missed
# pass is just a stale snapshot. 30 s jitter keeps it off the :00 crowd.
OnCalendar=*:0/5
RandomizedDelaySec=30
Persistent=false
Unit=isaflow-health-alerts.service

[Install]
WantedBy=timers.target
