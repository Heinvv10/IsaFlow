#!/usr/bin/env bash
set -euo pipefail

# git pipes <local-ref> <local-sha> <remote-ref> <remote-sha> on stdin;
# we don't inspect it but we don't want bun/vitest reading those lines either.
exec </dev/null

if [ "${SKIP_CI:-0}" = "1" ]; then
  echo "[pre-push] SKIP_CI=1 — bypassing checks"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
# Only the fast, diff-scoped subset (scripts/ci/run-ci.sh, group prepush): the full gate (build, browser tests,
# integration, every unit file) runs on GitHub, where the merge queue re-tests each batch. Run it by hand with `bun run ci`.
echo "[pre-push] running bun run ci prepush..."
# The print-parity tests (about five minutes) run only when the push touches what they hold: tests/unit/printParity/parityScope.ts.
PARITY_SCOPE=diff bun run ci prepush
