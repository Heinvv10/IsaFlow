[Unit]
Description=Daily trigger for the IsaFlow budget-holder slice reminders (budgets P5-6)

[Timer]
# 06:00 SAST every day, before the working day. Randomised 0-300 s delay, as the
# sibling timers.
OnCalendar=*-*-* 06:00:00 Africa/Johannesburg
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
