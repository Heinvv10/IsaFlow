[Unit]
Description=10-minute trigger for IsaFlow sent-folder mirror scan
Requires=isaflow-sent-mirror-scan.service

[Timer]
# Every 10 minutes. The cron endpoint internally respects each connection's
# scan_interval_minutes, so frequent firing is cheap for idle connections.
OnBootSec=10min
OnUnitActiveSec=10min
RandomizedDelaySec=60
Persistent=false

[Install]
WantedBy=timers.target
