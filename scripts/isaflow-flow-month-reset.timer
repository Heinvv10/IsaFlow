[Unit]
Description=First-of-month trigger for IsaFlow PAYG Flow counter reset

[Timer]
# First day of each month at 00:05 SAST. Resets month_flows_used and
# nudge_level on every flow_wallet row so the monthly nudge starts fresh.
OnCalendar=*-*-01 00:05:00 Africa/Johannesburg
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
