[Unit]
Description=IsaFlow — daily dunning ladder walker (PRD-06 Phase 5)
After=network-online.target isaflow.service
Wants=network-online.target

# The X-Cron-Secret header reaches curl on stdin (-H @-), never its argv, which
# /proc/<pid>/cmdline shows every local account (scripts/isaflow-management-packs.service).
[Service]
Type=oneshot
User=velo
Group=velo
EnvironmentFile=/home/velo/isaflow/.env.local
ExecStart=/bin/sh -c 'printf "X-Cron-Secret: %%s\\n" "$$CRON_SECRET" | exec /usr/bin/curl --silent --show-error --fail \
  --max-time 600 \
  -X POST \
  -H @- \
  -H "Content-Type: application/json" \
  http://127.0.0.1:3101/api/cron/dunning-send'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=isaflow-dunning-send

NoNewPrivileges=true
ProtectSystem=strict
