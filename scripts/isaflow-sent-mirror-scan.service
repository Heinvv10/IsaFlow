[Unit]
Description=IsaFlow — sent-folder mirror IMAP scan (PRD-06 Phase 6)
After=network-online.target isaflow.service
Wants=network-online.target

[Service]
Type=oneshot
User=velo
Group=velo
EnvironmentFile=/home/velo/isaflow/.env.local
ExecStart=/usr/bin/curl --silent --show-error --fail \
  --max-time 300 \
  -X POST \
  -H "X-Cron-Secret: ${CRON_SECRET}" \
  -H "Content-Type: application/json" \
  http://127.0.0.1:3101/api/cron/sent-mirror-scan

StandardOutput=journal
StandardError=journal
SyslogIdentifier=isaflow-sent-mirror-scan

NoNewPrivileges=true
ProtectSystem=strict
