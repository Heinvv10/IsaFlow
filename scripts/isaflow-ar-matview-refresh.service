[Unit]
Description=IsaFlow — nightly AR views materialised view refresh (PRD-06 Phase 2)
After=network-online.target isaflow.service
Wants=network-online.target

[Service]
Type=oneshot
User=velo
Group=velo
EnvironmentFile=/home/velo/isaflow/.env.local
ExecStart=/usr/bin/curl --silent --show-error --fail \
  --max-time 300 \
  -X POST \
  -H "X-Cron-Secret: ${CRON_SECRET}" \
  -H "Content-Type: application/json" \
  http://127.0.0.1:3101/api/cron/ar-matview-refresh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=isaflow-ar-matview-refresh

NoNewPrivileges=true
ProtectSystem=strict
