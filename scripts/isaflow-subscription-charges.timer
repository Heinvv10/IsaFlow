[Unit]
Description=Trigger for the IsaFlow subscription charges cron

[Timer]
# Hourly, as the route's header says. A Type=oneshot service cannot overlap itself, the
# per-period charge check stops a second charge for the same period, and each attempt is
# claimed before Paystack is called, so a retry on timer jitter is safe. Randomised 0-300 s delay.
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
