[Unit]
Description=IsaFlow — intercompany auto-accept (P2): drafts for the messages a receiving company asked to accept automatically
After=network-online.target isaflow.service
Wants=network-online.target

# Accepts, as the RECEIVER, the intercompany invoice / credit-note messages that a company
# asked to have accepted automatically (group connections only): a DRAFT supplier invoice /
# credit note, nothing approved. The X-Cron-Secret header reaches curl on stdin (-H @-), never
# its argv, which /proc/<pid>/cmdline shows every local account
# (scripts/isaflow-management-packs.service). CRON_SECRET must never be written here.
# --max-time 300 is the ceiling: the worker starts no new message after AUTO_ACCEPT_BUDGET_MS (200 s,
# autoAcceptWorker.ts) and leaves the rest to the next run, so keep that constant below this value.

[Service]
Type=oneshot
User=velo
Group=velo
EnvironmentFile=/home/velo/isaflow/.env.local
ExecStart=/bin/sh -c 'printf "X-Cron-Secret: %%s\\n" "$$CRON_SECRET" | exec /usr/bin/curl --silent --show-error --fail \
  --max-time 300 \
  -X POST \
  -H @- \
  -H "Content-Type: application/json" \
  http://127.0.0.1:3101/api/cron/intercompany-auto-accept'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=isaflow-intercompany-auto-accept

NoNewPrivileges=true
ProtectSystem=strict
