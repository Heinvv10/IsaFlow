[Unit]
Description=IsaFlow - daily trial lifecycle emails (day 3, day 10, 5 days before the end, ended)
After=network-online.target
Wants=network-online.target

# The X-Cron-Secret header reaches curl on stdin (-H @-), never its argv, which
# /proc/<pid>/cmdline shows every local account (scripts/isaflow-management-packs.service).
# Real sends also need TRIAL_LIFECYCLE_EMAILS_ENABLED=1 in the env file; without it the
# endpoint runs as a dry run. See scripts/README-trial-lifecycle-emails-cron.md.
[Service]
Type=oneshot
User=velo
Group=velo
EnvironmentFile=/home/velo/isaflow/.env.local
ExecStart=/bin/sh -c 'printf "X-Cron-Secret: %%s\\n" "$$CRON_SECRET" | exec /usr/bin/curl --silent --show-error --fail \
  --max-time 900 \
  -X POST \
  -H @- \
  -H "Content-Type: application/json" \
  http://127.0.0.1:3101/api/cron/trial-lifecycle-emails'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=isaflow-trial-lifecycle-emails

NoNewPrivileges=true
ProtectSystem=strict
