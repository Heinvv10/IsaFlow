# Accounting App - Environment Variables
# Copy to .env.local and fill in real values

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Environment
NODE_ENV=development

# Public app URL (match package.json `dev` script port — currently 3200)
# Do NOT add a second NEXT_PUBLIC_APP_URL line for prod; put the prod URL in
# your hosting env (Vercel env, systemd service, etc.), never in .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3200
# Local dev admin URL only. Production must set:
# NEXT_PUBLIC_ADMIN_URL=https://admin.isaflow.co.za
NEXT_PUBLIC_ADMIN_URL=http://localhost:3200
ALLOWED_ORIGINS=http://localhost:3200,http://localhost:3004

# Paystack Payment Gateway (test keys for dev / staging).
# Production uses sk_live_/pk_live_; supply in hosting env, NEVER in .env.local.
# - PAYSTACK_SECRET_KEY     — used server-side for transaction init/verify,
#                              charge_authorization, plan/subscription, AND
#                              webhook HMAC-SHA512 signature verification.
# - PAYSTACK_PUBLIC_KEY     — used client-side only (currently unused; we use
#                              the hosted-checkout redirect rather than Inline).
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_TEST_SECRET
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PAYSTACK_TEST_PUBLIC

# Flow bundle purchases with NO gateway configured.
# Without PAYSTACK_SECRET_KEY, POST /api/billing/flows/purchase returns 503:
# a missing gateway secret is an outage, not a free top-up. Set this to the
# exact string "true" on a local or dev process that deliberately runs without
# Paystack and needs the admin-recorded fallback to credit the wallet.
# It is IGNORED when NODE_ENV=production, and `next build` + `next start` sets
# NODE_ENV=production — so ANY deployed environment, pilot included, ignores it.
# ALLOW_UNPAID_FLOW_PURCHASE=true

# SMTP (email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@isaflow.co.za

# Bank Feeds — Stitch OAuth + GraphQL (legacy, still in use for bank data).
# This is SEPARATE from Stitch's payments product, which has been replaced by
# Paystack above. The bank-feed integration uses the user.bankAccounts query.
STITCH_CLIENT_ID=your-stitch-client-id
STITCH_CLIENT_SECRET=your-stitch-client-secret
STITCH_REDIRECT_URI=http://localhost:3200/api/accounting/bank-feeds/callback

# Admin seed password (used by db:migrate)
ADMIN_PASSWORD=change-me-in-production

# Neon driver transport (set to 'true' to force HTTP instead of WebSocket)
NEON_USE_HTTP=false

# VLM — Vision Language Model for document OCR
VLM_MODEL=your-vlm-model-id
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT=120000

# Encryption key for bank feed OAuth tokens (generate: openssl rand -base64 32)
ENCRYPTION_KEY=

# Anthropic API key for AI features (NL query, categorization, forecasting)
ANTHROPIC_API_KEY=

# Resend email API (alternative to SMTP)
RESEND_API_KEY=

# VF Storage URL for document uploads
VF_STORAGE_URL=

# --- Self-hosted Supabase (auth + storage) ---
# Kong gateway base URL — storage API routes at $SUPABASE_URL/storage/v1
SUPABASE_URL=http://100.96.203.105:7770
GOTRUE_URL=http://100.96.203.105:7770/auth/v1
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket for invoices / receipts / statements captured via email, PWA, API
SUPABASE_CAPTURED_DOCS_BUCKET=captured-documents
# Postmark inbound webhook token — rejects unsigned POSTs to /capture/inbound/email
POSTMARK_INBOUND_TOKEN=

# System cron secret — protects /api/cron/* endpoints (generate: openssl rand -hex 32)
CRON_SECRET=

# E2E test credentials — REQUIRED by tests/e2e/_creds.ts (getE2ECredentials() throws if unset).
# Never commit real values; set in your local shell or a gitignored .env.local.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Error tracking (Bugsink) ---
# Set to 'true' to enable Sentry.init. Defaults to off so the SDK is dark.
SENTRY_ENABLED=false
# Per-project DSN issued by Bugsink at https://errors.isaflow.co.za
SENTRY_DSN=
# Source-map upload (build-time only) — leave empty locally
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://errors.isaflow.co.za
SENTRY_ORG=isaflow-platform
SENTRY_PROJECT=isaflow
# Browser SDK (must mirror server vars; NEXT_PUBLIC_* are inlined at build time)
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GIT_SHA=

# --- Client Portal + Signum e-signature ---
# Signum base API URL (server-side only)
SIGNUM_API_URL=https://signum.velocityfibre.co.za/api/v1
# API key from Signum admin console (sk_live_...)
SIGNUM_API_KEY=
# HMAC secret — used to verify X-Signum-Signature header (64-char hex)
SIGNUM_WEBHOOK_SECRET=
# Passed to Signum per-document; also used server-side for iframe src
SIGNUM_CALLBACK_BASE_URL=https://app.isaflow.co.za/sign
# How many days before signing links expire
SIGNUM_EXPIRES_IN_DAYS=14
# Signs portal_session cookies — SEPARATE from JWT_SECRET (generate: openssl rand -hex 32).
# REQUIRED: validateEnv() will refuse to start the app without this set.
PORTAL_JWT_SECRET=
# Signs admin→tenant impersonation JWTs — SEPARATE from JWT_SECRET (generate: openssl rand -hex 32).
# REQUIRED: validateEnv() will refuse to start the app without this set.
# 30 min TTL on issued tokens, so rotation is a no-op operationally.
IMPERSONATION_JWT_SECRET=
# Signs the short-lived print token the PDF pipeline (src/lib/pdf/renderPagePdf.ts)
# uses to authenticate a headless-browser render against one API path
# (generate: openssl rand -hex 32). OPTIONAL: the withAuth print-token
# fallback is disabled entirely when this is unset. When set, must be at
# least 32 characters — printAuth.ts and validateEnv() both enforce that.
PRINT_TOKEN_SECRET=
# The app's own origin, SERVER-SIDE. Distinct from NEXT_PUBLIC_APP_URL above,
# which is a build-time value the browser bundle carries: this one is read at
# request time by src/lib/pdf/renderPagePdf.ts to build the URL the headless
# browser navigates to, and it must be reachable FROM the renderer — which for
# Gotenberg means from inside its container (host.docker.internal:3200 locally,
# the real hostname in production), not from this process. REQUIRED for the
# pack PDF download; unset, renderPagePdf throws "APP_URL is not set" and the
# route 500s. The PPTX download does not need it — that one assembles the deck
# in-process and launches no browser.
APP_URL=http://host.docker.internal:3200
# Root directory for AFS file storage (signed PDFs, rendered HTML)
# Defaults to <cwd>/storage on dev. Set to an absolute path on Velocity (e.g. /var/isaflow/storage).
AFS_STORAGE_ROOT=

# ── Phase 3: Admin platform auth ────────────────────────────────────────────
# Dedicated Postgres role with BYPASSRLS for admin.isaflow.co.za runtime.
# Create via migration 352, then rotate the password via ALTER ROLE.
# Required for withPlatformAdmin middleware to open its admin-pool transaction.
PLATFORM_ADMIN_DATABASE_URL=postgresql://platform_admin:CHANGEME@localhost:5437/isaflow?sslmode=disable

# Share auth cookies across app.isaflow.co.za and admin.isaflow.co.za.
# Leave unset for localhost dev (subdomain sharing requires eTLD+1 host).
# COOKIE_DOMAIN=.isaflow.co.za

# WhatsApp (Twilio WABA)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── SharePoint Integration ───────────────────────────────────────────────────
# Register an Azure app at portal.azure.com with application permission Sites.Read.All.
# Grant admin consent, then copy the credentials below.
# Leave blank to disable the "From SharePoint" button in the document panel.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Full SharePoint site URL (no trailing slash)
SHAREPOINT_SITE_URL=https://blitzfibre.sharepoint.com/sites/VelocityFinance
