{
  "manifest_version": 3,
  "name": "ISAFlow Sage Connector",
  "version": "1.1.0",
  "description": "Lets ISAFlow read your Sage Business Cloud session cookie so admins can auto-import data without bookmarklets.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://accounting.sageone.co.za/*",
    "https://app.isaflow.co.za/*",
    "https://admin.isaflow.co.za/*",
    "http://localhost:*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://app.isaflow.co.za/*",
        "https://admin.isaflow.co.za/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon128.png" }
}
