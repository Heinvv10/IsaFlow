{
  "name": "isaflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start -p 3200",
    "lint": "eslint src pages --report-unused-disable-directives",
    "type-check": "tsc --noEmit",
    "check:routes": "node scripts/check-duplicate-next-routes.mjs",
    "agent-docs:generate": "node scripts/mirror-agent-docs.mjs",
    "agent-docs:check": "node scripts/mirror-agent-docs.mjs --check",
    "test:unit": "node scripts/check-runtime.mjs && bun run check:routes && vitest run",
    "test:unit:watch": "node scripts/check-runtime.mjs && vitest",
    "test:e2e": "playwright test --config playwright-test.config.ts",
    "test:e2e:golden": "playwright test --config playwright-golden.config.ts",
    "test:integration": "node scripts/check-runtime.mjs && vitest run --config vitest.integration.config.ts",
    "test:coverage": "node scripts/check-runtime.mjs && vitest run --coverage",
    "test": "node scripts/check-runtime.mjs && vitest run && playwright test --config playwright-test.config.ts",
    "ci": "bash scripts/ci/run-ci.sh",
    "ci:install-hooks": "bash scripts/ci/install-hooks.sh",
    "db:migrate": "bun scripts/apply-migrations.ts",
    "db:audit-drift": "bun scripts/audit-schema-drift.ts",
    "db:integrity-check": "bun scripts/integrity-check.ts",
    "prepare": "bash scripts/ci/install-hooks.sh || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.48.0",
    "@supabase/storage-js": "^2.104.0",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "decimal.js": "^10.6.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "formidable": "^3.5.4",
    "imapflow": "^1.3.2",
    "ioredis": "^5.10.1",
    "jose": "^6.1.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lru-cache": "^11.2.7",
    "lucide-react": "^1.8.0",
    "mailparser": "^3.9.8",
    "next": "14.2.35",
    "nodemailer": "^8.0.4",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.6.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^6.0.0",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.4",
    "@neondatabase/serverless": "^1.0.1",
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/formidable": "^3.5.0",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.11",
    "@types/papaparse": "^5.3.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^4.7.0",
    "otpauth": "^9.5.0",
    "pdfkit": "^0.18.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.12.0",
    "bun": ">=1.3.0"
  }
}
